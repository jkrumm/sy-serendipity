---
import { getPhoto, getPhotoSrcSet, type PhotoOptions } from '@/util/get-image';
import { imageMeta } from '@/util/images';
import styles from './photo.module.scss';

type Props = Omit<PhotoOptions, 'width' | 'height'> & {
  alt?: string;
  width?: number;
  height?: number;
  sizes?: string;
  eager?: boolean;
  class?: string;
  position?: string;
};

const {
  name,
  alt = imageMeta(name).alt,
  width = 1600,
  height = 1000,
  sizes = '100vw',
  quality,
  gravity,
  maxWidth,
  eager = false,
  class: className,
  position = 'center',
} = Astro.props;
const photo = { name, width, height, quality, gravity, maxWidth };
---

<img
  src={getPhoto(photo)}
  srcset={getPhotoSrcSet(photo)}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class:list={[styles.photo, className]}
  style={{ 'object-position': position }}
/>
