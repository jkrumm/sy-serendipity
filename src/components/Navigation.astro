---
import { getImg } from '@/util/get-image';
import { navigationLinks } from '@/content/navigation';
import { isActive } from '@/util/is-active';
import styles from './navigation.module.scss';

const links = navigationLinks;
---

<header class={styles.header} data-site-header>
  <div class={styles.bar}>
    <a href="/" class={styles.brand} aria-label="Serendipity I — home">
      <img src={getImg('old-logo-blue-icon', 74)} alt="" width="148" height="242" />
      <span>Serendipity I</span>
    </a>
    <nav class={styles.desktop} aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(Astro.url.pathname, link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/request/" class={`button ${styles.desktopRequest}`}>Request a charter</a>
    </nav>
    <div class={styles.mobileActions}>
      <a href="/request/" class={`button ${styles.mobileRequest}`}>Request</a>
      <button
        class={styles.menuButton}
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-toggle
      >
        <span data-menu-label>Menu</span>
        <span class={styles.menuIcon} aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id="mobile-navigation" class={styles.mobile} aria-label="Main" hidden>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(Astro.url.pathname, link.href) ? 'page' : undefined}
            >
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="eyebrow">45 metres · 8 guests · 7 crew</p>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const label = header?.querySelector<HTMLElement>('[data-menu-label]');
  const menu = document.getElementById('mobile-navigation');

  if (header && toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      label.textContent = open ? 'Close' : 'Menu';
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden));
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || menu.hidden) return;
      setOpen(false);
      toggle.focus();
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setOpen(false);
    });
    window.matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));
  }
</script>
