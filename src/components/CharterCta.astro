---
import styles from './charter-cta.module.scss';

type Props = {
  title?: string;
  body?: string;
};

const {
  title = 'Charter Serendipity I',
  body = 'Contact Ocean Independence to discuss your preferred dates and destinations.',
} = Astro.props;
---

<section class={`section-shell ${styles.cta}`} aria-labelledby="charter-invitation">
  <h2 id="charter-invitation">{title}</h2>
  <p class={styles.body}>{body}</p>
  <a
    class="button"
    href="/request/"
    data-umami-event="request-cta"
    data-umami-event-location="cta-band">Request a charter <span aria-hidden="true">↗</span></a
  >
</section>
