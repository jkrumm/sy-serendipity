---
import { navigationLinks, requestLink } from '@/content/navigation';
import { getImgOld } from '@/util/get-image';
import styles from './footer.module.scss';

const links = [...navigationLinks, requestLink];
---

<footer class={styles.footer}>
  <div class={`section-shell ${styles.content}`}>
    <div class={styles.top}>
      <a href="/" class={styles.brand} aria-label="Serendipity I — home">
        <img src={getImgOld('logo-blue.svg')} alt="Serendipity I" width="288" height="288" />
      </a>
      <div class={styles.destination}>
        <p class="eyebrow">Charter destinations</p>
        <p>The South Pacific.<br />Until summer 2028.</p>
        <a href="/#destinations">Explore the destinations <span aria-hidden="true">↗</span></a>
      </div>
      <nav aria-label="Footer">
        <ul>
          {
            links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class={styles.bottom}>
      <p>© {new Date().getFullYear()} Serendipity I</p>
      <a href="/legal-disclaimer/">Legal disclaimer & privacy</a>
    </div>
  </div>
</footer>
