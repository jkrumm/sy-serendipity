---
import Wordmark from '@/components/Wordmark.astro';
import { home } from '@/content/home';
import { getPhoto } from '@/util/get-image';
import styles from './hero.module.scss';

const { hero } = home;
const mobileWidths = [390, 640, 780];
const desktopWidths = [960, 1280, 1600, 1920];
const mobileSet = mobileWidths
  .map(
    (width) =>
      `${getPhoto({ ...hero.mobile, width, height: Math.round(width * 1.7), quality: 68 })} ${width}w`,
  )
  .join(', ');
const desktopSet = desktopWidths
  .map(
    (width) =>
      `${getPhoto({ ...hero.desktop, width, height: Math.round(width / 1.93), quality: 78 })} ${width}w`,
  )
  .join(', ');
---

<section class={styles.hero} aria-labelledby="hero-title">
  <picture class={styles.picture}>
    <source media="(max-width: 699px)" srcset={mobileSet} sizes="100vw" width="780" height="1326" />
    <img
      src={getPhoto({ ...hero.desktop, width: 1600, height: 829, quality: 78 })}
      srcset={desktopSet}
      sizes="100vw"
      width="1920"
      height="995"
      alt={hero.desktop.alt}
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class={styles.shade}></div>
  <div class={styles.content}>
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-title">
      <Wordmark class={styles.wordmark} />
      <span class="sr-only">{hero.title}</span>
    </h1>
    <div class={styles.actions}>
      <a
        href="/request/"
        class={styles.explore}
        data-umami-event="request-cta"
        data-umami-event-location="home-hero"
      >
        {hero.link}
        <span aria-hidden="true">↗</span>
      </a>
      <button type="button" class={styles.watchFilm} data-film-open aria-haspopup="dialog">
        <span aria-hidden="true">▷</span>
        {home.film.button}
      </button>
    </div>
  </div>
  <dialog
    id="yacht-film"
    class={styles.filmDialog}
    aria-label={home.film.title}
    data-source={home.film.source}
  >
    <button type="button" data-film-close>
      {home.film.close}
      <span aria-hidden="true">×</span>
    </button>
    {/* eslint-disable astro/jsx-a11y/media-has-caption -- Supplementary scenic film; yacht information is provided in the surrounding page text. */}
    <video
      controls
      playsinline
      preload="none"
      aria-label={home.film.title}
      data-poster={getPhoto({ ...home.film.image, width: 1280, height: 720 })}
    ></video>
    {/* eslint-enable astro/jsx-a11y/media-has-caption */}
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#yacht-film');
  const video = dialog?.querySelector('video');
  document.querySelectorAll('[data-film-open]').forEach((button) =>
    button.addEventListener('click', () => {
      if (!dialog || !video) return;
      video.poster ||= video.dataset.poster ?? '';
      video.src ||= dialog.dataset.source ?? '';
      dialog.showModal();
    }),
  );
  dialog?.querySelector('[data-film-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('close', () => video?.pause());
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
