---
import { formatDateTime, formatTravelDates, mailtoHref, relativeTime } from './format';
import type { CharterRequest } from './requests';
import styles from './admin.module.scss';

type Props = { request: CharterRequest; muted?: boolean };
const { request, muted = false } = Astro.props;

const name =
  [request.firstName, request.lastName].filter(Boolean).join(' ') ||
  request.email ||
  'Unknown sender';
const guests = request.numberOfPeople
  ? `${request.numberOfPeople} ${request.numberOfPeople === '1' ? 'guest' : 'guests'}`
  : null;
const dates = formatTravelDates(request.arrivalDate, request.departureDate);
const facts = [guests, request.destination, dates, request.duration].filter(Boolean);
const mailHref = mailtoHref(request.email, 'Your charter request – SY Serendipity I');
const phoneHref = request.phone ? `tel:${request.phone.replace(/[^\d+]/g, '')}` : null;
---

<li class:list={[styles.request, muted && styles.requestMuted]}>
  <details>
    <summary>
      <span class={styles.requestTop}>
        <strong>{name}</strong>
        <time datetime={request.receivedAt} title={formatDateTime(request.receivedAt)}>
          {relativeTime(request.receivedAt)}
        </time>
      </span>
      {facts.length > 0 && <span class={styles.requestFacts}>{facts.join(' · ')}</span>}
    </summary>
    <div class={styles.requestBody}>
      <p class={styles.muted}>Received {formatDateTime(request.receivedAt)}</p>
      {request.message && <p class={styles.message}>{request.message}</p>}
      <dl>
        {request.email && (
          <>
            <dt>E-mail</dt>
            <dd>{request.email}</dd>
          </>
        )}
        {request.phone && (
          <>
            <dt>Phone</dt>
            <dd>{request.phone}</dd>
          </>
        )}
      </dl>
      <div class={styles.actions}>
        {mailHref && (
          <a class={styles.actionPrimary} href={mailHref}>
            Reply by e-mail
          </a>
        )}
        {phoneHref && (
          <a class={styles.action} href={phoneHref}>
            Call
          </a>
        )}
      </div>
    </div>
  </details>
</li>
