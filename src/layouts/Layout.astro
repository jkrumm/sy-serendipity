---
import '@/styles/tailwind.css';
import '@/styles/global.scss';
import '@/styles/overrides.scss';

import Footer from '@/components/Footer.astro';
import GoogleTag from '@/components/GoogleTag.astro';
import Navigation from '@/components/Navigation.astro';
import { SEO_IMAGE } from '@/util/get-image';

type Props = {
  title?: string;
  description?: string;
};

const DEFAULT_TITLE = 'SY SERENDIPITY I';
const HOME_TITLE = 'Charter Sailing Yacht | Set Sails. Now.';
const DEFAULT_DESCRIPTION =
  'Discover Serendipity I, a 45 m Perini Navi sailing yacht for eight guests and a crew of seven. Private charter in the South Pacific until summer 2028.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

function fullTitle(): string {
  if (!title) return DEFAULT_TITLE;
  if (title === HOME_TITLE) return `${DEFAULT_TITLE} | ${title}`;
  return `${title} | ${DEFAULT_TITLE}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f2eb" />
    <title>{fullTitle()}</title>
    <meta name="description" content={description} />
    <meta name="image" content={SEO_IMAGE} />
    <meta property="og:title" content={fullTitle()} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={SEO_IMAGE} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle()} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link
      rel="preload"
      href="/fonts/AddingtonCF-Regular.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link rel="preload" href="/fonts/Brown Regular.woff2" as="font" type="font/woff2" crossorigin />
    <GoogleTag />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Navigation />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
