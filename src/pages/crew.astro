---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import CharterCta from '@/components/CharterCta.astro';
import { crewContent as content, crewImages as images } from '@/content/crew';
import styles from './crew.module.scss';
---

<Layout title={content.meta.title} description={content.meta.description}>
  <PageIntro {...content.intro} />

  <div class={`section-shell ${styles.profiles}`}>
    {
      content.profiles.map((profile, index) => (
        <section class={styles.profile} aria-labelledby={`crew-${index}`}>
          <figure>
            <Photo
              {...profile.image}
              sizes="(min-width: 900px) 400px, (min-width: 500px) 70vw, calc(100vw - 48px)"
              eager={index === 0}
            />
          </figure>
          <div class={styles.biography}>
            <p class="eyebrow">{profile.role}</p>
            <h2 id={`crew-${index}`}>{profile.name}</h2>
            {profile.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <section class={styles.dining} aria-labelledby="dining-title">
    <div class="section-shell">
      <div class={styles.diningHeading}>
        <p class="eyebrow">{content.dining.eyebrow}</p>
        <h2 id="dining-title">{content.dining.title}</h2>
      </div>
      <div class={styles.food}>
        <figure>
          <Photo
            {...images.breakfast}
            width={960}
            height={1120}
            sizes="(min-width: 700px) 50vw, 100vw"
          />
          <figcaption>{content.dining.breakfastCaption}</figcaption>
        </figure>
        <figure>
          <Photo
            {...images.aperitif}
            width={960}
            height={1120}
            sizes="(min-width: 700px) 50vw, 100vw"
          />
          <figcaption>{content.dining.aperitifCaption}</figcaption>
        </figure>
      </div>
      <p class={styles.welcome}>{content.welcome}</p>
    </div>
  </section>

  <CharterCta />
</Layout>
