---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Container from '@/components/Container.astro';
import H2 from '@/components/H2.astro';
import { getImg, getImgCropped, getImgCroppedOld, getImgOld } from '@/util/get-image';
import styles from './index.module.scss';
---

<Layout title="Charter Sailing Yacht | Set Sails. Now.">
  <Hero />
  <Container as="main">
    <section class="home">
      <div class={styles.textImage}>
        <div class={styles.content}>
          <div class={styles.img}>
            <img
              alt="ship-11"
              width="400"
              height="585"
              src={getImgOld('ship-11', 400, 585)}
              loading="lazy"
            />
          </div>
          <div class={styles.text}>
            <div>
              <a href="/about/">
                <H2 title="Serendipity I. Set sails. Now." />
              </a>
              <span>
                Some of the world’s most spectacular destinations are best experienced on the water.
                Enjoy an unrivalled sense of discovery, promise the highest level of exclusivity and
                luxury.
                <br />
                <br />
                For the epitome of adventure, or an elegant effortless family & friends trip, you discover
                astounding nature as well as cultural riches of port cities and remote archipelagos across
                the globe.
              </span>
              <div class="button-group">
                <a href="/about/">
                  <button type="button">About</button>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class={styles.textImageSecond}>
        <div class={styles.content}>
          <div class={styles.text}>
            <div>
              <span>
                Tell us about your passions, curiosities and motivations, and we will take you on a
                once-in-a-lifetime adventure, filled with priceless memories and unforgettable
                moments. We craft a perfectly tailored itinerary. Perhaps you have an experience in
                mind, but you’re unsure if it exists?
              </span>
            </div>
          </div>
          <div class={styles.img}>
            <img
              alt="outside-3"
              src={getImgCropped('outside-3', 525, 328)}
              width={525}
              height={328}
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class={styles.textImageThird}>
        <div class={styles.content}>
          <div class={styles.img}>
            <img
              alt="inside-1"
              src={getImg('inside-1', 420)}
              width={420}
              height={253}
              loading="lazy"
            />
            <img
              alt="inside-37"
              src={getImg('inside-37', 420)}
              width={420}
              height={253}
              loading="lazy"
            />
          </div>
          <div class={styles.text}>
            <div>
              <a href="/about/">
                <H2 title="Take a look inside" />
              </a>
              <span>
                We promise the highest level of exclusivity and luxury on every voyage. The yacht
                has been designed with relaxation in mind. Natural materials such as wood, leather
                and organic cotton are gentle on the eye, so the real star – the natural beauty of
                surrounding nature can take centre stage. Spacious decks with daybeds, dining areas
                offer great vantage points to enjoy the spectacular scenery.
              </span>
              <div class="button-group">
                <a href="/about/">
                  <button type="button">About</button>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class={styles.destinations}>
      <H2 title="History Hopping or Blissed Beaches" subtitle="Destinations" class="center" />
      <div>
        <span>
          A lush yacht holiday on Serendipity I promises freedom, privacy and luxury on the open
          ocean. Moor up in exclusive marinas. Hop between charming harbour towns. Explore hidden
          coves, dive spots and archipelagos – all at your own pace.
          <br />
          <br />
          Imagine golden sand, the sound of gentle rolling waves and a warm sea breeze. Add attentive
          service and a stress-free itinerary planned down to the smallest detail and you have arrived
          in your unparalleled private trip.
        </span>
      </div>
      <div class={styles.destinationOptions}>
        <div>
          <div>
            <h3>Mediterranean</h3>
            <span>From June to November</span>
            <span>Italy, Greece, France or islands</span>
          </div>
          <img
            alt="sy-serendipity-top"
            width="600"
            height="400"
            src={getImgCroppedOld('mediterranean-14', 600, 400)}
            loading="lazy"
          />
        </div>
        <div>
          <div>
            <h3>Caribbean</h3>
            <span>From December to May</span>
            <span>Caribbean, Maldives, Seychelles</span>
          </div>
          <img
            alt="sy-serendipity-top"
            width="600"
            height="400"
            loading="lazy"
            src={getImgCroppedOld('caribbean-31', 600, 400)}
          />
        </div>
      </div>
      <a href="/request/">
        <button class="action" type="button">
          <h2>REQUEST NOW</h2>
        </button>
      </a>
    </section>
  </Container>
</Layout>
