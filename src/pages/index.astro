---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Photo from '@/components/Photo.astro';
import CharterCta from '@/components/CharterCta.astro';
import { home, HOME_DESTINATION_IMAGES } from '@/content/home';
import styles from './index.module.scss';
---

<Layout title={home.title} description={home.description}>
  <Hero />
  <div class={styles.facts} aria-label="The yacht at a glance">
    {
      home.facts.map((fact) => (
        <div>
          <>
            <p>
              <span>{fact.value}</span> {fact.unit}
            </p>
            <small>{fact.detail}</small>
          </>
        </div>
      ))
    }
  </div>
  <section class={`section-shell ${styles.introduction}`} id="aboard">
    <div class={styles.introCopy}>
      <p class="eyebrow">{home.introduction.eyebrow}</p>
      <h2>{home.introduction.title}</h2>
      <p class={styles.lead}>{home.introduction.body}</p>
      <p>{home.introduction.detail}</p>
      <a href="/about/" class="text-link"
        >{home.introduction.link}<span aria-hidden="true">↗</span></a
      >
    </div>
    <figure>
      <Photo
        {...home.introduction.image}
        width={960}
        height={1100}
        sizes="(min-width: 800px) 49vw, 100vw"
      /><figcaption>{home.introduction.caption}</figcaption>
    </figure>
  </section>
  <section class={styles.onboard}>
    <div class={`section-shell ${styles.sectionHeading}`}>
      <div><p class="eyebrow">{home.onboard.eyebrow}</p><h2>{home.onboard.title}</h2></div>
      <p>{home.onboard.body}</p>
    </div>
    <div class={`section-shell ${styles.chapters}`}>
      {
        home.onboard.chapters.map((chapter) => (
          <a href={chapter.href}>
            <>
              <Photo
                {...chapter.image}
                width={1000}
                height={780}
                sizes="(min-width: 700px) 46vw, 100vw"
              />
              <div class={styles.chapterMeta}>
                <>
                  <span class="eyebrow">
                    {chapter.number} / {chapter.label}
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <h3>{chapter.title}</h3>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class={`section-shell ${styles.destinations}`} id="destinations">
    <div class={styles.sectionHeading}>
      <div>
        <p class="eyebrow">{home.destinations.eyebrow}</p><h2>{home.destinations.title}</h2>
      </div>
      <p>{home.destinations.body}</p>
    </div>
    <div class={styles.destinationStory}>
      <figure data-image-slot="home-south-pacific">
        <Photo
          {...HOME_DESTINATION_IMAGES.southPacific}
          width={1000}
          height={1100}
          sizes="(min-width: 900px) 46vw, 100vw"
        />
        <figcaption>{home.destinations.imageCaption}</figcaption>
      </figure>
      <div class={styles.destinationCopy}>
        <p class="eyebrow">{home.destinations.locations}</p>
        {home.destinations.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <figure class={styles.frangipani} data-image-slot="home-frangipani">
          <Photo
            {...HOME_DESTINATION_IMAGES.frangipani}
            width={960}
            height={720}
            sizes="(min-width: 900px) 39vw, 100vw"
          />
          <figcaption>{home.destinations.frangipaniCaption}</figcaption>
        </figure>
        <a href="/about/#cruising-title" class="text-link"
          >{home.destinations.link}<span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </section>
  <section class={styles.crew}>
    <div class={`section-shell ${styles.crewInner}`}>
      <Photo {...home.crew.image} width={900} height={950} sizes="(min-width: 800px) 45vw, 100vw" />
      <div>
        <p class="eyebrow">{home.crew.eyebrow}</p><h2>{home.crew.title}</h2><p>
          {home.crew.body}
        </p><a href="/crew/" class="text-link">{home.crew.link}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class={styles.film}>
    <Photo {...home.film.image} width={1920} height={1000} sizes="100vw" />
    <div class={styles.filmShade}></div>
    <div class={styles.filmContent}>
      <p class="eyebrow">{home.film.eyebrow}</p><h2>{home.film.title}</h2><button
        type="button"
        data-film-open
        aria-haspopup="dialog"
        ><span class={styles.play} aria-hidden="true">▷</span>{home.film.button}</button
      >
    </div>
  </section>

  <CharterCta />
</Layout>
