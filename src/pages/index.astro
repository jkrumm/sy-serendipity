---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Photo from '@/components/Photo.astro';
import CharterCta from '@/components/CharterCta.astro';
import Facts from '@/components/Facts.astro';
import { home, HOME_DESTINATION_IMAGES, HOME_TAILOR_PHOTOS } from '@/content/home';
import { YACHT_FACTS } from '@/content/facts';
import styles from './index.module.scss';
---

<Layout title={home.title} description={home.description}>
  <Hero />
  <Facts items={YACHT_FACTS} />
  <section class={`section-shell ${styles.introduction}`} id="aboard">
    <div class={styles.introCopy}>
      <p class="eyebrow">{home.introduction.eyebrow}</p>
      <h2 id="interior-title">{home.introduction.title}</h2>
      {home.introduction.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <div class={styles.introLinks}>
        {
          home.introduction.links.map((link) => (
            <a href={link.href} class="text-link">
              {link.label}
              <span aria-hidden="true">↗</span>
            </a>
          ))
        }
      </div>
    </div>
    <figure>
      <Photo
        {...home.introduction.image}
        width={960}
        height={1100}
        sizes="(min-width: 800px) 49vw, 100vw"
      /><figcaption>{home.introduction.caption}</figcaption>
    </figure>
  </section>
  <section class={styles.onboard}>
    <div class={`section-shell ${styles.sectionHeading}`}>
      <div><p class="eyebrow">{home.onboard.eyebrow}</p><h2>{home.onboard.title}</h2></div>
      <p>{home.onboard.body}</p>
    </div>
    <div class={`section-shell ${styles.chapters}`}>
      {
        home.onboard.chapters.map((chapter) => (
          <a href={chapter.href}>
            <>
              <Photo
                {...chapter.image}
                width={1000}
                height={780}
                sizes="(min-width: 700px) 32vw, 100vw"
              />
              <div class={styles.chapterMeta}>
                <>
                  <span class="eyebrow">
                    {chapter.number} / {chapter.label}
                  </span>
                  <span aria-hidden="true">↗</span>
                </>
              </div>
              <h3>{chapter.title}</h3>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <section class={`section-shell ${styles.destinations}`} id="destinations">
    <div class={styles.sectionHeading}>
      <div>
        <p class="eyebrow">{home.destinations.eyebrow}</p><h2 id="cruising-title">
          {home.destinations.title}
        </h2>
      </div>
      <p>{home.destinations.lead}</p>
    </div>
    <figure class={styles.destinationOpener} data-image-slot="home-marquesas-bay">
      <Photo
        {...HOME_DESTINATION_IMAGES.marquesasBay}
        width={1600}
        height={900}
        sizes="(min-width: 800px) min(800px, 80svh, calc(100vw - 128px)), min(800px, 80svh, calc(100vw - 48px))"
      />
      <figcaption>{home.destinations.openerCaption}</figcaption>
    </figure>
    <div class={styles.destinationStory}>
      <figure data-image-slot="home-marquesas-anchorage">
        <Photo
          {...HOME_DESTINATION_IMAGES.marquesasAnchorage}
          width={1000}
          height={1100}
          sizes="(min-width: 900px) 46vw, 100vw"
        />
        <figcaption>{home.destinations.anchorageCaption}</figcaption>
      </figure>
      <div class={styles.destinationCopy}>
        <p class="eyebrow">{home.destinations.locations}</p>
        {home.destinations.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        <figure class={styles.reefPhoto} data-image-slot="home-reef-anchorage">
          <Photo
            {...HOME_DESTINATION_IMAGES.reefAnchorage}
            width={960}
            height={720}
            sizes="(min-width: 900px) 39vw, 100vw"
          />
          <figcaption>{home.destinations.reefCaption}</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <section class={`section-shell ${styles.tailor}`} id="tailor">
    <figure class={styles.tailorOpener}>
      <Photo
        {...HOME_TAILOR_PHOTOS.sandbarAerial}
        width={1920}
        height={820}
        sizes="(min-width: 900px) min(1312px, calc(100vw - 128px)), calc(100vw - 48px)"
      />
      <figcaption>{home.destinations.tailor.openerCaption}</figcaption>
    </figure>
    <div class={styles.tailorHeading}>
      <p class="eyebrow">{home.destinations.tailor.eyebrow}</p>
      <h2>{home.destinations.tailor.title}</h2>
      <p class={styles.tailorLead}>{home.destinations.tailor.paragraphs[0]}</p>
    </div>
    <div class={styles.tailorStrip}>
      <figure>
        <Photo
          {...HOME_TAILOR_PHOTOS.blackPearls}
          width={800}
          height={800}
          sizes="(min-width: 700px) 30vw, calc(100vw - 48px)"
        />
        <figcaption>{home.destinations.tailor.stripCaptions.blackPearls}</figcaption>
      </figure>
      <figure>
        <Photo
          {...HOME_TAILOR_PHOTOS.frangipani}
          width={800}
          height={800}
          sizes="(min-width: 700px) 30vw, calc(100vw - 48px)"
        />
        <figcaption>{home.destinations.tailor.stripCaptions.frangipani}</figcaption>
      </figure>
      <figure>
        <Photo
          {...HOME_TAILOR_PHOTOS.lagoonShallows}
          width={800}
          height={800}
          sizes="(min-width: 700px) 30vw, calc(100vw - 48px)"
        />
        <figcaption>{home.destinations.tailor.stripCaptions.lagoonShallows}</figcaption>
      </figure>
    </div>
    <div class={styles.tailorFiji}>
      <figure>
        <Photo
          {...HOME_TAILOR_PHOTOS.palmShore}
          width={800}
          height={1000}
          sizes="(min-width: 900px) 39vw, calc(100vw - 48px)"
        />
        <figcaption>{home.destinations.tailor.fijiPhotoCaption}</figcaption>
      </figure>
      <div class={styles.tailorFijiCopy}>
        <p class="eyebrow">{home.destinations.tailor.fijiEyebrow}</p>
        {home.destinations.tailor.paragraphs.slice(1).map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
  <section class={styles.crew}>
    <div class={`section-shell ${styles.crewInner}`}>
      <Photo {...home.crew.image} width={900} height={950} sizes="(min-width: 800px) 45vw, 100vw" />
      <div>
        <p class="eyebrow">{home.crew.eyebrow}</p><h2>{home.crew.title}</h2><p>
          {home.crew.body}
        </p><a href="/crew/" class="text-link">{home.crew.link}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class={styles.activities}>
    <div class={`section-shell ${styles.activitiesInner}`}>
      <div>
        <p class="eyebrow">{home.activities.eyebrow}</p><h2 id="activities-title">
          {home.activities.title}
        </h2><p>
          {home.activities.body}
        </p><a href="/activities/" class="text-link"
          >{home.activities.link}<span aria-hidden="true">↗</span></a
        >
      </div>
      <Photo
        {...home.activities.image}
        width={900}
        height={950}
        sizes="(min-width: 800px) 45vw, 100vw"
      />
    </div>
  </section>
  <section class={styles.film}>
    <Photo {...home.film.image} width={1920} height={1000} sizes="100vw" />
    <div class={styles.filmShade}></div>
    <div class={styles.filmContent}>
      <p class="eyebrow">{home.film.eyebrow}</p><h2>{home.film.title}</h2><button
        type="button"
        data-film-open
        aria-haspopup="dialog"
        ><span class={styles.play} aria-hidden="true">▷</span>{home.film.button}</button
      >
    </div>
  </section>

  <CharterCta />
</Layout>
