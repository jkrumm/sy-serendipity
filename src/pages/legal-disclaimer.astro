---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import styles from './legal-disclaimer.module.scss';

const company = {
  name: 'WFD Holdings ltd',
  address: ['375 Advanced House', 'Level 2', 'Manwel Dimech Street', '1058 Sliema', 'Malta'],
  telephone: 'tbc',
  email: 'info@sy-serendipity.org',
  registration: 'tbc',
  vat: 'MT 288 581 28',
};
---

<Layout
  title="Legal Disclaimer"
  description="Legal disclaimer and privacy policy of SY Serendipity I."
>
  <PageIntro eyebrow="Company information" title="Legal disclaimer" />
  <section class={`section-shell ${styles.legal}`} aria-labelledby="company-name">
    <div>
      <p class="eyebrow">Company</p>
      <h2 id="company-name">{company.name}</h2>
    </div>
    <div class={styles.details}>
      <address>
        {company.address.map((line) => (
          <span>{line}</span>
        ))}
      </address>
      <dl>
        <div>
          <dt>Telephone</dt>
          <dd>{company.telephone}</dd>
        </div>
        <div>
          <dt>E-mail</dt>
          <dd>
            <a
              href={`mailto:${company.email}`}
              data-umami-event="email-click"
              data-umami-event-location="legal"
            >
              {company.email}
            </a>
          </dd>
        </div>
        <div>
          <dt>Company registration</dt>
          <dd>{company.registration}</dd>
        </div>
        <div>
          <dt>VAT ID</dt>
          <dd>{company.vat}</dd>
        </div>
      </dl>
    </div>
  </section>
  <section class={`section-shell ${styles.privacy}`} aria-labelledby="privacy-title">
    <div>
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title">Your Data</h2>
    </div>
    <div class={styles.privacyText}>
      <h3>who is responsible</h3>
      <p>
        {company.name}, {company.address.join(', ')}. Contact:{' '}
        <a
          href={`mailto:${company.email}`}
          data-umami-event="email-click"
          data-umami-event-location="legal-privacy"
        >
          {company.email}
        </a>
        .
      </p>
      <h3>statistics</h3>
      <p>
        We measure visits with Umami, self-hosted by us on a server in the EU; requests to it pass
        through this website's domain. There are no cookies, no cross-site tracking and no IP
        addresses are stored. We also use anonymised session recordings and click maps, with all
        form inputs masked.
      </p>
      <h3>charter requests</h3>
      <p>
        The details in the request form are sent by e-mail to the charter team and used only to
        answer your request.
      </p>
    </div>
  </section>
</Layout>
