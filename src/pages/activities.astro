---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import VideoLoop from '@/components/VideoLoop.astro';
import CharterCta from '@/components/CharterCta.astro';
import {
  activitiesContent as content,
  activitiesImages as images,
  activitiesLoops,
} from '@/content/activities';
import styles from './activities.module.scss';
---

<Layout
  title={content.meta.title}
  description={content.meta.description}
  image={content.meta.image}
>
  <PageIntro {...content.intro} />

  <section class={`section-shell ${styles.film}`} aria-labelledby="film-title" data-loops-container>
    <div class={styles.filmHeading}>
      <div>
        <p class="eyebrow">{content.film.eyebrow}</p>
        <h2 id="film-title">{content.film.title}</h2>
      </div>
      <p>{content.film.line}</p>
      <button
        type="button"
        class={styles.toggle}
        data-loops-toggle
        data-label-on={content.film.toggleOn}
        data-label-off={content.film.toggleOff}
        aria-pressed="false"
      >
        {content.film.toggleOn}
      </button>
    </div>
    <div class={styles.loops}>
      {activitiesLoops.map((loop, index) => (
        <VideoLoop
          src={`/video/activities-${loop.slug}.mp4`}
          poster={`/video/activities-${loop.slug}.jpg`}
          label={loop.label}
          width={loop.width}
          height={loop.height}
          class={index === 0 ? styles.loopWide : undefined}
        />
      ))}
    </div>
  </section>

  <section class={`section-shell ${styles.equipment}`} aria-labelledby="equipment-title">
    <div class={styles.equipmentGrid}>
      <div class={styles.equipmentCopy}>
        <div class={styles.sectionHeading}>
          <p class="eyebrow">{content.equipment.eyebrow}</p>
          <h2 id="equipment-title">{content.equipment.title}</h2>
        </div>
        <div class={styles.lists}>
          <div>
            <h3 class="eyebrow">{content.equipment.waterLabel}</h3>
            <ul>
              {content.equipment.waterToys.map((toy) => (
                <li>{toy}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="eyebrow">{content.equipment.deckLabel}</h3>
            <ul>
              {content.equipment.deckToys.map((toy) => (
                <li>{toy}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class={styles.equipmentCollage}>
        <figure class={styles.equipmentWide}>
          <Photo
            {...images.seabob}
            width={900}
            height={600}
            sizes="(min-width: 900px) 46vw, (min-width: 700px) 90vw, 100vw"
          />
        </figure>
        <div class={styles.equipmentPair}>
          <figure>
            <Photo
              {...images.supBoard}
              width={700}
              height={875}
              sizes="(min-width: 900px) 22vw, (min-width: 700px) 44vw, 46vw"
            />
          </figure>
          <figure>
            <Photo
              {...images.tender}
              width={700}
              height={875}
              sizes="(min-width: 900px) 22vw, (min-width: 700px) 44vw, 46vw"
            />
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class={styles.wellness} aria-labelledby="wellness-title">
    <div class={`section-shell ${styles.twoColHeading}`}>
      <div>
        <p class="eyebrow">{content.wellness.eyebrow}</p>
        <h2 id="wellness-title">{content.wellness.title}</h2>
      </div>
      <p>{content.wellness.line}</p>
    </div>
    <div class={`section-shell ${styles.wellnessRow}`}>
      <figure>
        <Photo
          {...images.downwardDog}
          width={900}
          height={600}
          sizes="(min-width: 700px) 30vw, 78vw"
        />
      </figure>
      <figure>
        <Photo
          {...images.headstand}
          width={900}
          height={600}
          sizes="(min-width: 700px) 30vw, 78vw"
        />
      </figure>
      <figure>
        <Photo
          {...images.meditation}
          width={900}
          height={600}
          sizes="(min-width: 700px) 30vw, 78vw"
        />
      </figure>
    </div>
  </section>

  <section class={`section-shell ${styles.ashore}`} aria-labelledby="ashore-title">
    <div class={styles.twoColHeading}>
      <div>
        <p class="eyebrow">{content.ashore.eyebrow}</p>
        <h2 id="ashore-title">{content.ashore.title}</h2>
      </div>
      <p>{content.ashore.paragraph}</p>
    </div>
    <div class={styles.ashoreGrid}>
      <div class={styles.ashoreList}>
        <ul>
          {content.ashore.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <a href={content.ashore.link.href} class="text-link">
          {content.ashore.link.label}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <figure class={styles.ashoreBeach}>
        <Photo
          {...images.motuBeach}
          width={800}
          height={1000}
          sizes="(min-width: 900px) 30vw, (min-width: 500px) 46vw, 84vw"
        />
      </figure>
      <figure class={styles.ashoreReef}>
        <Photo
          {...images.reef}
          width={800}
          height={1000}
          sizes="(min-width: 900px) 30vw, (min-width: 500px) 46vw, 84vw"
        />
      </figure>
    </div>
  </section>

  <CharterCta />
</Layout>
