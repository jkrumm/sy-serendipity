---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import VideoLoop from '@/components/VideoLoop.astro';
import CharterCta from '@/components/CharterCta.astro';
import {
  activitiesContent as content,
  activitiesImages as images,
  activitiesLoops,
} from '@/content/activities';
import styles from './activities.module.scss';
---

<Layout title={content.meta.title} description={content.meta.description}>
  <PageIntro {...content.intro} />

  <figure class={`section-shell ${styles.opener}`}>
    <Photo
      {...images.opener}
      width={1600}
      height={900}
      sizes="(min-width: 900px) min(1100px, 80svh, calc(100vw - 128px)), min(1100px, 80svh, calc(100vw - 48px))"
    />
    <figcaption>The tender crossing open water, a motu on the horizon</figcaption>
  </figure>

  <section class={`section-shell ${styles.film}`} aria-labelledby="film-title" data-loops-container>
    <div class={styles.filmHeading}>
      <div>
        <p class="eyebrow">{content.film.eyebrow}</p>
        <h2 id="film-title">{content.film.title}</h2>
      </div>
      <p>{content.film.line}</p>
      <button
        type="button"
        class={styles.toggle}
        data-loops-toggle
        data-label-on={content.film.toggleOn}
        data-label-off={content.film.toggleOff}
        aria-pressed="false">{content.film.toggleOn}</button
      >
    </div>
    <div class={styles.loops}>
      {
        activitiesLoops.map((loop, index) => (
          <VideoLoop
            src={`/video/activities-${loop.slug}.mp4`}
            poster={`/video/activities-${loop.slug}.jpg`}
            label={loop.caption}
            width={loop.width}
            height={loop.height}
            class={index === 0 ? styles.loopWide : undefined}
          >
            {loop.caption}
          </VideoLoop>
        ))
      }
    </div>
  </section>

  <section class={`section-shell ${styles.equipment}`} aria-labelledby="equipment-title">
    <div class={styles.sectionHeading}>
      <p class="eyebrow">{content.equipment.eyebrow}</p>
      <h2 id="equipment-title">{content.equipment.title}</h2>
    </div>
    <div class={styles.lists}>
      <div>
        <h3 class="eyebrow">{content.equipment.waterLabel}</h3>
        <ul>{content.equipment.waterToys.map((toy) => <li>{toy}</li>)}</ul>
      </div>
      <div>
        <h3 class="eyebrow">{content.equipment.deckLabel}</h3>
        <ul>{content.equipment.deckToys.map((toy) => <li>{toy}</li>)}</ul>
      </div>
    </div>
    <figure class={styles.equipmentWide}>
      <Photo {...images.seabob} width={1600} height={1067} sizes="100vw" />
    </figure>
    <div class={styles.equipmentPair}>
      <figure>
        <Photo
          {...images.supBoard}
          width={900}
          height={1350}
          sizes="(min-width: 700px) 46vw, 100vw"
        />
      </figure>
      <figure>
        <Photo
          {...images.tender}
          width={900}
          height={1350}
          sizes="(min-width: 700px) 46vw, 100vw"
        />
      </figure>
    </div>
  </section>

  <section class={`section-shell ${styles.wellness}`} aria-labelledby="wellness-title">
    <figure class={styles.wellnessWide}>
      <Photo {...images.downwardDog} width={1600} height={1067} sizes="100vw" />
    </figure>
    <div class={styles.wellnessPair}>
      <figure>
        <Photo
          {...images.headstand}
          width={900}
          height={600}
          sizes="(min-width: 700px) 46vw, 100vw"
        />
      </figure>
      <figure>
        <Photo
          {...images.meditation}
          width={900}
          height={600}
          sizes="(min-width: 700px) 46vw, 100vw"
        />
      </figure>
    </div>
    <div class={styles.wellnessHeading}>
      <p class="eyebrow">{content.wellness.eyebrow}</p>
      <h2 id="wellness-title">{content.wellness.title}</h2>
      <p>{content.wellness.line}</p>
    </div>
  </section>

  <section class={`section-shell ${styles.ashore}`} aria-labelledby="ashore-title">
    <div class={styles.ashoreHeading}>
      <p class="eyebrow">{content.ashore.eyebrow}</p>
      <h2 id="ashore-title">{content.ashore.title}</h2>
      <p>{content.ashore.paragraph}</p>
    </div>
    <div class={styles.ashorePair}>
      <figure class={styles.ashoreBeach}>
        <Photo
          {...images.motuBeach}
          width={800}
          height={1422}
          sizes="(min-width: 700px) 36vw, 68vw"
        />
      </figure>
      <figure class={styles.ashoreWaterfall}>
        <Photo
          {...images.waterfall}
          width={1000}
          height={750}
          sizes="(min-width: 700px) 55vw, 100vw"
        />
      </figure>
    </div>
  </section>

  <CharterCta />
</Layout>
