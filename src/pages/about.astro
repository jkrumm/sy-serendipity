---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import CharterCta from '@/components/CharterCta.astro';
import { aboutContent as content, aboutImages as images } from '@/content/about';
import styles from './about.module.scss';
---

<Layout title={content.meta.title} description={content.meta.description}>
  <PageIntro {...content.intro} />

  <div class={styles.opening}>
    <figure class={styles.hero}>
      <Photo {...images.aftDeck} width={1920} height={1080} eager sizes="100vw" />
      <figcaption>{content.heroCaption}</figcaption>
    </figure>
    <dl class={styles.facts}>
      {
        content.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <section class={`section-shell ${styles.interior}`} aria-labelledby="interior-title">
    <div class={styles.cabin}>
      <figure>
        <Photo
          {...images.ownersCabin}
          width={1200}
          height={1080}
          sizes="(min-width: 900px) 57vw, 100vw"
        />
        <figcaption>{content.interior.caption}</figcaption>
      </figure>
      <div class={styles.copy}>
        <p class="eyebrow">{content.interior.eyebrow}</p>
        <h2 id="interior-title">{content.interior.title}</h2>
        {content.interior.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class={styles.saloon}>
      <div class={styles.copy}>
        <p class="eyebrow">{content.sharedSpaces.eyebrow}</p>
        <h2>{content.sharedSpaces.title}</h2>
        {content.sharedSpaces.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <figure>
        <Photo
          {...images.saloon}
          width={1000}
          height={750}
          sizes="(min-width: 900px) 43vw, 100vw"
        />
        <figcaption>{content.sharedSpaces.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class={styles.activities} aria-labelledby="activities-title">
    <div class={`section-shell ${styles.activitiesIntro}`}>
      <div>
        <p class="eyebrow">{content.activities.eyebrow}</p>
        <h2 id="activities-title">{content.activities.title}</h2>
      </div>
      <p>{content.activities.description}</p>
    </div>
    <figure class={styles.yoga}>
      <Photo {...images.yoga} width={1920} height={960} sizes="100vw" />
      <figcaption>{content.activities.yogaCaption}</figcaption>
    </figure>
    <div class={`section-shell ${styles.activityDetails}`}>
      <div class={styles.toys}>
        <div>
          <h3 class="eyebrow">{content.activities.waterLabel}</h3>
          <ul>{content.activities.waterToys.map((toy) => <li>{toy}</li>)}</ul>
        </div>
        <div>
          <h3 class="eyebrow">{content.activities.deckLabel}</h3>
          <ul>{content.activities.deckToys.map((toy) => <li>{toy}</li>)}</ul>
        </div>
      </div>
      <figure>
        <Photo
          {...images.sailing}
          width={960}
          height={1080}
          sizes="(min-width: 900px) 40vw, 100vw"
        />
        <figcaption>{content.activities.sailingCaption}</figcaption>
      </figure>
    </div>
  </section>

  <section class={`section-shell ${styles.cruising}`} aria-labelledby="cruising-title">
    <div class={styles.cruisingHeading}>
      <div>
        <p class="eyebrow">{content.cruising.eyebrow}</p>
        <h2 id="cruising-title">{content.cruising.title}</h2>
        <p class={styles.cruisingSeason}>{content.cruising.season}</p>
      </div>
      <p class={styles.cruisingIntroduction}>{content.cruising.introduction}</p>
    </div>
    <div class={styles.cruisingPhotographs}>
      {
        content.cruising.photographs.map((photograph) =>
          photograph ? (
            <figure>
              <Photo
                {...photograph}
                width={1200}
                height={900}
                sizes="(min-width: 900px) 45vw, calc(100vw - 48px)"
              />
              <figcaption>{photograph.caption}</figcaption>
            </figure>
          ) : null,
        )
      }
    </div>
    <div class={styles.cruisingPassages}>
      {
        content.cruising.passages.map((passage) => (
          <section
            class={styles.cruisingPassage}
            data-destination={passage.id}
            aria-labelledby={`destination-${passage.id}`}
          >
            <h3 class="eyebrow" id={`destination-${passage.id}`}>
              {passage.title}
            </h3>
            {passage.image && (
              <figure>
                <Photo
                  {...passage.image}
                  width={1200}
                  height={800}
                  sizes="(min-width: 900px) 45vw, calc(100vw - 48px)"
                />
                <figcaption>{passage.image.caption}</figcaption>
              </figure>
            )}
            {passage.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))
      }
    </div>
    <a class="text-link" href={content.cruising.href}>
      {content.cruising.link}<span aria-hidden="true">↗</span>
    </a>
  </section>

  <section class={styles.technical} aria-labelledby="technical-title">
    <div class={`section-shell ${styles.technicalInner}`}>
      <div class={styles.copy}>
        <p class="eyebrow">{content.technical.eyebrow}</p>
        <h2 id="technical-title">{content.technical.title}</h2>
        <p>{content.technical.description}</p>
        <a class="text-link" href={content.technical.href}>
          {content.technical.link}<span aria-hidden="true">↗</span>
        </a>
      </div>
      <dl class={styles.specifications}>
        {
          content.technical.specifications.map((specification) => (
            <div>
              <dt>{specification.label}</dt>
              <dd>{specification.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class={`section-shell ${styles.crew}`} aria-labelledby="crew-title">
    <div>
      <p class="eyebrow">{content.crew.eyebrow}</p>
      <h2 id="crew-title">{content.crew.title}</h2>
    </div>
    <div class={styles.copy}>
      <p>{content.crew.description}</p>
      <a class="text-link" href={content.crew.href}>
        {content.crew.link}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <CharterCta />
</Layout>
