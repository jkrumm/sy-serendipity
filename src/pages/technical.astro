---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import Facts from '@/components/Facts.astro';
import { TECHNICAL_COPY, TECHNICAL_IMAGES, SPECIFICATIONS } from '@/content/technical';
import { YACHT_FACTS } from '@/content/facts';
import { getImg } from '@/util/get-image';
import { imageMeta } from '@/util/images';
import styles from './technical.module.scss';
---

<Layout title="Technical" description={TECHNICAL_COPY.description}>
  <PageIntro
    eyebrow={TECHNICAL_COPY.eyebrow}
    title={TECHNICAL_COPY.title}
    description={TECHNICAL_COPY.intro}
  />
  <div class={`section-shell ${styles.technical}`}>
    <Facts items={YACHT_FACTS} label="Serendipity I at a glance" />
    <section class={styles.specifications} aria-label="Yacht specifications">
      <figure class={styles.blueprint}>
        <img
          src={getImg(TECHNICAL_IMAGES.profile.name, 506)}
          srcset={[320, 506]
            .map((width) => `${getImg(TECHNICAL_IMAGES.profile.name, width)} ${width}w`)
            .join(', ')}
          sizes="(min-width: 900px) 40vw, 90vw"
          width="506"
          height="1024"
          alt={TECHNICAL_IMAGES.profile.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class={styles.tables}>
        {SPECIFICATIONS.map(({ title, rows }) => (
          <table>
            <caption>{title}</caption>
            <tbody>
              {rows.map(({ label, value }) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ))}
      </div>
    </section>
    <section class={styles.deckPlans} aria-labelledby="deck-plans-title">
      <div class={styles.sectionHeading}>
        <p class="eyebrow">{TECHNICAL_COPY.plansEyebrow}</p>
        <h2 id="deck-plans-title">{TECHNICAL_COPY.plansTitle}</h2>
      </div>
      {TECHNICAL_IMAGES.plans.map(({ name, alt, caption }, index) => (
        <figure>
          <img
            src={getImg(name, 1440)}
            srcset={[480, 800, 1200, 1600, 1920]
              .map((size) => `${getImg(name, size)} ${size}w`)
              .join(', ')}
            sizes="(min-width: 1440px) 1312px, 90vw"
            width={imageMeta(name).width}
            height={imageMeta(name).height}
            alt={alt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <span>0{index + 1}</span>
            {caption}
          </figcaption>
        </figure>
      ))}
    </section>
    <section class={styles.cockpit} aria-labelledby="cockpit-title">
      <div class={styles.sectionHeading}>
        <p class="eyebrow">{TECHNICAL_COPY.cockpitEyebrow}</p>
        <h2 id="cockpit-title">{TECHNICAL_COPY.cockpitTitle}</h2>
      </div>
      <div class={styles.cockpitImages}>
        {TECHNICAL_IMAGES.cockpit.map(({ name, alt }) => (
          <figure>
            <Photo
              name={name}
              alt={alt}
              width={1200}
              height={900}
              sizes="(min-width: 700px) 45vw, 90vw"
            />
          </figure>
        ))}
      </div>
    </section>
  </div>
</Layout>
