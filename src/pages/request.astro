---
import Layout from '@/layouts/Layout.astro';
import PageIntro from '@/components/PageIntro.astro';
import Photo from '@/components/Photo.astro';
import RequestForm from '@/islands/RequestForm';
import { REQUEST_COPY, REQUEST_IMAGE, REQUEST_BROKER_IMAGE } from '@/content/request';
import { BROKER_LOGO } from '@/util/get-image';
import styles from './request.module.scss';
---

<Layout title="Request" description={REQUEST_COPY.description}>
  <PageIntro
    eyebrow={REQUEST_COPY.eyebrow}
    title={REQUEST_COPY.title}
    description={REQUEST_COPY.intro}
  />
  <div class={`section-shell ${styles.request}`}>
    <div class={styles.contactLayout}>
      <aside class={styles.broker} aria-labelledby="broker-title">
        <div class={styles.brokerDetails}>
          <div class={styles.brokerIdentity}>
            <Photo
              {...REQUEST_BROKER_IMAGE}
              width={160}
              height={160}
              sizes="160px"
              class={styles.brokerPortrait}
            />
            <div>
              <h2 id="broker-title">{REQUEST_COPY.broker.name}</h2>
              <p>{REQUEST_COPY.broker.role}</p>
            </div>
          </div>
          <address>
            <span>{REQUEST_COPY.broker.office}</span>
            <a class={styles.brokerPhone} href={REQUEST_COPY.broker.phoneHref}
              >{REQUEST_COPY.broker.phone}</a
            >
          </address>
          <a
            class={styles.brokerLink}
            href={REQUEST_COPY.broker.link}
            target="_blank"
            rel="noreferrer"
          >
            {REQUEST_COPY.broker.linkLabel}<span aria-hidden="true">↗</span>
          </a>
          <img
            class={styles.brokerLogo}
            src={BROKER_LOGO}
            alt={REQUEST_COPY.broker.logoAlt}
            width="230"
            height="69"
            loading="lazy"
          />
        </div>
        <Photo
          name={REQUEST_IMAGE.name}
          alt={REQUEST_IMAGE.alt}
          width={900}
          height={800}
          sizes="(min-width: 1000px) 34vw, 90vw"
        />
      </aside>
      <section class={styles.formPanel} aria-labelledby="request-form-title">
        <div class={styles.formIntro}>
          <h2 id="request-form-title">{REQUEST_COPY.formTitle}</h2>
          <p>{REQUEST_COPY.formIntro}</p>
        </div>
        <RequestForm client:load />
        <noscript>
          <p>{REQUEST_COPY.formFallback}</p>
          <a class="text-link" href={REQUEST_COPY.broker.phoneHref}>{REQUEST_COPY.broker.phone}</a>
        </noscript>
        <div class={styles.cruising}>
          <p class="eyebrow">{REQUEST_COPY.cruisingLabel}</p>
          <dl>
            <div>
              <dt>{REQUEST_COPY.cruising.destination}</dt>
              <dd>{REQUEST_COPY.cruising.availability}</dd>
            </div>
          </dl>
        </div>
      </section>
    </div>
  </div>
</Layout>
