---
import Layout from '@/layouts/Layout.astro';
import Photo from '@/components/Photo.astro';
import type { ImageId } from '@/util/images';
import styles from './404.module.scss';

const content: { title: string; description: string; image: ImageId; imageAlt: string } = {
  title: 'Page not found',
  description:
    'The page you requested could not be found. Return to the home page or contact the charter broker.',
  image: 'deck-23',
  imageAlt: 'The bow rail of Serendipity I looking out across the open sea',
};
---

<Layout title="Page not found" description="The requested page could not be found.">
  <section class={`section-shell ${styles.page}`} aria-labelledby="not-found-title">
    <div class={styles.copy}>
      <p class="eyebrow">Error 404</p>
      <h1 id="not-found-title">{content.title}</h1>
      <p class={styles.description}>{content.description}</p>
      <div class={styles.links}>
        <a href="/" class="button">Home page <span aria-hidden="true">↗</span></a>
        <a
          href="/request/"
          class="text-link"
          data-umami-event="request-cta"
          data-umami-event-location="404">Request a charter <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <Photo
      name={content.image}
      alt={content.imageAlt}
      width={1000}
      height={1100}
      sizes="(min-width: 800px) 50vw, 100vw"
      eager
      class={styles.photo}
    />
  </section>
</Layout>
