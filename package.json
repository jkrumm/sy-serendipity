{
  "name": "sy-serendipity",
  "description": "SY Serendipity - Charter Sailing Yacht - Set Sails. Now.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Johannes Krumm <jkrumm@pm.me>",
  "license": "MIT",
  "homepage": "https://sy-serendipity.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jkrumm/sy-serendipity"
  },
  "scripts": {
    "dev": "bunx kill-port ${PORT:-7734} && astro dev",
    "build": "astro build",
    "preview": "bunx kill-port ${PORT:-7734} && astro preview --port ${PORT:-7734}",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint 'src/**/*.{ts,tsx,astro}' astro.config.ts eslint.config.js",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx,astro}' astro.config.ts eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "astro build && bunx netlify-cli@27.12.0 deploy --prod --dir=dist --no-build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.9",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-international-phone": "4.8.0",
    "tailwindcss": "4.3.3",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sass-embedded": "1.105.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
