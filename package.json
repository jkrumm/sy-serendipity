{
  "name": "sy-serendipity",
  "description": "SY Serendipity - Charter Sailing Yacht - Set Sails. Now.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "author": "Johannes Krumm <jkrumm@pm.me>",
  "license": "MIT",
  "homepage": "https://sy-serendipity.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jkrumm/sy-serendipity"
  },
  "scripts": {
    "dev": "bunx kill-port ${PORT:-7734} && astro dev",
    "build": "astro build",
    "preview": "bunx kill-port ${PORT:-7734} && astro preview --port ${PORT:-7734}",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "oxlint --type-aware .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "deploy": "astro build && bunx netlify-cli@27.12.0 deploy --prod --dir=dist --no-build",
    "lint:fix": "oxlint --type-aware --fix ."
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@astrojs/netlify": "8.2.9",
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "date-fns": "4.4.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-international-phone": "4.8.0",
    "tailwindcss": "4.3.3",
    "yet-another-react-lightbox": "3.32.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "sass-embedded": "1.105.1",
    "typescript": "6.0.3"
  }
}
