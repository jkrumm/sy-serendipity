{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sy-serendipity",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "sy-serendipity.org", "custom_domain": true }],
}
