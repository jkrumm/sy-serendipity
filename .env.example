# Analytics is Umami (src/components/Analytics.astro, production builds only): no env var.

# /api/request forwards to email-gateway. Local dev reads these from .env; on Netlify set
# EMAIL_GATEWAY_SECRET_KEY (optional at build time, needed at runtime) as a site environment variable (scope: Functions). Value: op://vps/email-gateway/SECRET_KEY
EMAIL_GATEWAY_URL=https://email-gateway.jkrumm.com
EMAIL_GATEWAY_SECRET_KEY=

# Admin panel (/admin/). All optional for `astro build`; without them the pages show a "not
# configured" notice. On Netlify set the secrets as site environment variables (scope: Functions).
# Read-only key for GET /sy-serendipity/requests. Value: op://vps/email-gateway/SY_SERENDIPITY_READ_KEY
EMAIL_GATEWAY_READ_KEY=
# API key of the view-only Umami user `sy-serendipity-viewer`. Value: op://common/sy-serendipity-admin
UMAMI_API_KEY=
# Login password and cookie-signing secret. Values: op://common/sy-serendipity-admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Defaults shown; only set to point at another Umami instance or website.
# UMAMI_URL=https://umami.jkrumm.com
# UMAMI_WEBSITE_ID=<website-uuid>
