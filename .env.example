# Google Analytics measurement id (G-XXXXXXXXXX). Optional; gtag is skipped when unset.
PUBLIC_GA_TRACKING_ID=
# PREVIEW=1 marks a build as a preview deploy: the Layout renders a noindex/nofollow robots
# meta tag and omits the canonical link. Not a required var — set it on the build command,
# e.g. `PREVIEW=1 bun run build`, never in .env.
# /api/request forwards to email-gateway. Local dev reads these from .env; on Netlify set
# EMAIL_GATEWAY_SECRET_KEY as a site environment variable (scope: Functions). Value: op://vps/email-gateway/SECRET_KEY
EMAIL_GATEWAY_URL=https://email-gateway.jkrumm.com
EMAIL_GATEWAY_SECRET_KEY=
