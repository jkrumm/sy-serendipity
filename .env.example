# Google Analytics measurement id (G-XXXXXXXXXX). Optional; gtag is skipped when unset.
PUBLIC_GA_TRACKING_ID=
# /api/request forwards to bun-email-api. Local dev reads these from .env; on Netlify set
# BEA_SECRET_KEY as a site environment variable (scope: Functions). Value: op://vps/bun-email-api/SECRET_KEY
BEA_BASE_URL=https://bun-email-api.jkrumm.com
BEA_SECRET_KEY=
